# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 git 에 올라가지 않는다.

# PostgreSQL (학습 데이터: ashrae DB)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<postgres-password>
PGDATABASE=ashrae

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_URI=postgresql+psycopg://postgres:<postgres-password>@localhost:5432/mlflow
MLFLOW_ARTIFACTS=s3://mlflow

# S3 호환 저장소 (RustFS 등) — MLflow 서버만 사용
MLFLOW_S3_ENDPOINT_URL=http://<host>:9000
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
AWS_DEFAULT_REGION=us-east-1

# Kaggle (또는 저장소 루트의 kaggleToken 파일)
KAGGLE_API_TOKEN=<kaggle-api-token>
